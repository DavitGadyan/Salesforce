SF_ACCESS_TOKEN=
# Option B: OAuth username-password flow with a Connected App
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=            # password + security token
