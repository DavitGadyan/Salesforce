ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# BULK_MODEL=claude-haiku-5-5

# AI router: other providers (optional)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# PRIVATE_LLM_BASE_URL=http://localhost:11434/v1   # Ollama, vLLM, LM Studio...
